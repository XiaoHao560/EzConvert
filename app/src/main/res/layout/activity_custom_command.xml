<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_height="match_parent"
    android:layout_width="match_parent"
    android:background="?attr/colorSurfaceContainerLowest">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_height="wrap_content"
        android:layout_width="match_parent"
        android:background="@android:color/transparent"
        android:elevation="0dp"
        app:elevation="0dp"
        android:id="@+id/custom_command_toolbar_container">

        <com.google.android.material.appbar.MaterialToolbar
            android:layout_height="wrap_content"
            android:layout_width="match_parent"
            android:background="@android:color/transparent"
            app:navigationIconTint="?attr/colorOnSurfaceVariant"
            app:title="@string/custom_command_title"
            app:titleCentered="true"
            app:navigationIcon="@drawable/round_arrow_back"
            style="@style/Widget.Material3.Toolbar.Surface"
            app:navigationContentDescription="@string/tooltip_back"
            android:id="@+id/custom_command_toolbar">

        </com.google.android.material.appbar.MaterialToolbar>

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_height="match_parent"
        android:layout_width="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        android:scrollbarStyle="outsideOverlay"
        android:fillViewport="true"
        android:fadeScrollbars="true"
        android:clipToPadding="false"
        android:id="@+id/custom_command_scroll">

        <LinearLayout
            android:layout_height="wrap_content"
            android:layout_width="match_parent"
            android:paddingEnd="16dp"
            android:orientation="vertical"
            android:paddingBottom="20dp"
            android:paddingStart="16dp"
            android:paddingTop="8dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_height="wrap_content"
                android:layout_width="match_parent"
                android:layout_marginBottom="12dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="?attr/colorSecondaryContainer"
                app:cardCornerRadius="16dp">

                <TextView
                    android:layout_height="wrap_content"
                    android:layout_width="match_parent"
                    android:drawablePadding="10dp"
                    android:padding="16dp"
                    android:textSize="14sp"
                    android:textColor="?attr/colorOnSecondaryContainer"
                    android:text="@string/custom_command_intro" />

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_height="wrap_content"
                android:layout_width="match_parent"
                android:layout_marginBottom="12dp"
                app:strokeColor="?attr/colorOutline"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="@android:color/transparent"
                style="@style/Widget.Material3.CardView.Outlined"
                app:cardCornerRadius="16dp">

                <LinearLayout
                    android:layout_height="wrap_content"
                    android:layout_width="match_parent"
                    android:padding="16dp"
                    android:orientation="vertical">

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_height="wrap_content"
                        android:layout_width="match_parent"
                        android:hint="@string/custom_command_execution_mode"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                        android:layout_marginTop="4dp">

                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:layout_height="wrap_content"
                            android:layout_width="match_parent"
                            android:inputType="none"
                            android:id="@+id/custom_command_mode_spinner" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <View
                        android:layout_height="1dp"
                        android:layout_width="match_parent"
                        android:layout_marginBottom="12dp"
                        android:background="?attr/colorOutlineVariant"
                        android:layout_marginTop="8dp" />

                    <TextView
                        android:layout_height="wrap_content"
                        android:layout_width="match_parent"
                        android:textSize="16sp"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="?attr/colorOnSurface"
                        android:text="@string/custom_command_inputs_title" />

                    <TextView
                        android:layout_height="wrap_content"
                        android:layout_width="match_parent"
                        android:background="?attr/colorSurfaceContainerHigh"
                        android:minHeight="48dp"
                        android:padding="12dp"
                        android:textSize="14sp"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:layout_marginTop="8dp"
                        android:id="@+id/custom_command_input_list"
                        android:text="@string/custom_command_no_inputs" />

                    <LinearLayout
                        android:layout_height="wrap_content"
                        android:layout_width="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_marginTop="8dp">

                        <com.google.android.material.button.MaterialButton
                            android:layout_height="wrap_content"
                            android:layout_width="0dp"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_weight="1"
                            android:id="@+id/custom_command_add_inputs"
                            android:text="@string/custom_command_add_inputs" />

                        <com.google.android.material.button.MaterialButton
                            android:layout_height="wrap_content"
                            android:layout_width="wrap_content"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:id="@+id/custom_command_clear_inputs"
                            android:text="@string/custom_command_clear_inputs" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_height="wrap_content"
                android:layout_width="match_parent"
                android:layout_marginBottom="12dp"
                app:strokeColor="?attr/colorOutline"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="@android:color/transparent"
                style="@style/Widget.Material3.CardView.Outlined"
                app:cardCornerRadius="16dp">

                <LinearLayout
                    android:layout_height="wrap_content"
                    android:layout_width="match_parent"
                    android:padding="16dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_height="wrap_content"
                        android:layout_width="match_parent"
                        android:textSize="16sp"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="?attr/colorOnSurface"
                        android:text="@string/custom_command_editor_title" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_height="wrap_content"
                        android:layout_width="match_parent"
                        app:hintEnabled="false"
                        android:layout_marginTop="10dp"
                        app:boxBackgroundMode="outline">

                        <com.google.android.material.textfield.TextInputEditText
                            android:layout_height="220dp"
                            android:layout_width="match_parent"
                            android:scrollbars="vertical"
                            android:gravity="top|start"
                            android:hint="@string/custom_command_editor_hint"
                            android:padding="12dp"
                            android:fontFamily="monospace"
                            android:textSize="13sp"
                            android:importantForAutofill="no"
                            android:inputType="textMultiLine|textNoSuggestions"
                            android:id="@+id/custom_command_editor" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <LinearLayout
                        android:layout_height="wrap_content"
                        android:layout_width="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_marginTop="4dp">

                        <com.google.android.material.button.MaterialButton
                            android:layout_height="wrap_content"
                            android:layout_width="wrap_content"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:minWidth="0dp"
                            android:id="@+id/custom_command_insert_placeholder"
                            android:text="@string/custom_command_insert_placeholder" />

                        <com.google.android.material.button.MaterialButton
                            android:layout_height="wrap_content"
                            android:layout_width="wrap_content"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:minWidth="0dp"
                            android:id="@+id/custom_command_examples"
                            android:text="@string/custom_command_examples" />

                    </LinearLayout>

                    <TextView
                        android:layout_height="wrap_content"
                        android:layout_width="match_parent"
                        android:textSize="12sp"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:paddingTop="2dp"
                        android:text="@string/custom_command_placeholders_help" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_height="wrap_content"
                android:layout_width="match_parent"
                android:layout_marginBottom="12dp"
                app:strokeColor="?attr/colorOutline"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="@android:color/transparent"
                style="@style/Widget.Material3.CardView.Outlined"
                app:cardCornerRadius="16dp">

                <LinearLayout
                    android:layout_height="wrap_content"
                    android:layout_width="match_parent"
                    android:padding="16dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_height="wrap_content"
                        android:layout_width="match_parent"
                        android:textSize="16sp"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="?attr/colorOnSurface"
                        android:text="@string/custom_command_outputs_title" />

                    <TextView
                        android:layout_height="wrap_content"
                        android:layout_width="match_parent"
                        android:background="?attr/colorSurfaceContainerHigh"
                        android:padding="12dp"
                        android:textSize="14sp"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:layout_marginTop="8dp"
                        android:id="@+id/custom_command_output_location"
                        android:text="@string/custom_command_output_follow_settings" />

                    <LinearLayout
                        android:layout_height="wrap_content"
                        android:layout_width="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_marginTop="8dp">

                        <com.google.android.material.button.MaterialButton
                            android:layout_height="wrap_content"
                            android:layout_width="0dp"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_weight="1"
                            android:id="@+id/custom_command_choose_folder"
                            android:text="@string/custom_command_choose_folder" />

                        <com.google.android.material.button.MaterialButton
                            android:layout_height="wrap_content"
                            android:layout_width="wrap_content"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:id="@+id/custom_command_choose_file"
                            android:text="@string/custom_command_choose_file" />

                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:id="@+id/custom_command_toggle_output_options"
                        android:text="@string/custom_command_show_advanced_outputs" />

                    <TextView
                        android:layout_height="wrap_content"
                        android:layout_width="match_parent"
                        android:visibility="gone"
                        android:textSize="12sp"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:id="@+id/custom_command_output_names_help"
                        android:paddingTop="4dp"
                        android:text="@string/custom_command_output_names_help" />

                    <LinearLayout
                        android:layout_height="wrap_content"
                        android:layout_width="match_parent"
                        android:visibility="gone"
                        android:orientation="vertical"
                        android:layout_marginTop="8dp"
                        android:id="@+id/custom_command_output_rows">

                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"
                        android:visibility="gone"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:id="@+id/custom_command_add_output"
                        android:text="@string/custom_command_add_output" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_height="wrap_content"
                android:layout_width="match_parent"
                android:layout_marginBottom="12dp"
                app:strokeColor="?attr/colorOutline"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="@android:color/transparent"
                style="@style/Widget.Material3.CardView.Outlined"
                app:cardCornerRadius="16dp">

                <LinearLayout
                    android:layout_height="wrap_content"
                    android:layout_width="match_parent"
                    android:padding="12dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_height="wrap_content"
                        android:layout_width="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:layout_height="wrap_content"
                            android:layout_width="0dp"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_weight="1"
                            android:id="@+id/custom_command_preview"
                            android:text="@string/custom_command_preview" />

                        <com.google.android.material.button.MaterialButton
                            android:layout_height="wrap_content"
                            android:layout_width="wrap_content"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:id="@+id/custom_command_save_preset"
                            android:text="@string/custom_command_save_preset" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_height="wrap_content"
                        android:layout_width="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:layout_height="wrap_content"
                            android:layout_width="0dp"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_weight="1"
                            android:id="@+id/custom_command_load_preset"
                            android:text="@string/custom_command_load_preset" />

                        <com.google.android.material.button.MaterialButton
                            android:layout_height="wrap_content"
                            android:layout_width="wrap_content"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:id="@+id/custom_command_delete_preset"
                            android:text="@string/custom_command_delete_preset" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:layout_height="wrap_content"
                android:layout_width="match_parent"
                android:layout_marginBottom="8dp"
                app:icon="@drawable/round_play_arrow"
                android:minHeight="54dp"
                app:cornerRadius="16dp"
                android:id="@+id/custom_command_execute"
                android:text="@string/custom_command_execute"
                app:iconGravity="textStart" />

            <com.google.android.material.button.MaterialButton
                android:layout_height="wrap_content"
                android:layout_width="match_parent"
                android:visibility="gone"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:id="@+id/custom_command_cancel"
                android:text="@string/custom_command_cancel_task" />

            <com.google.android.material.card.MaterialCardView
                android:layout_height="wrap_content"
                android:layout_width="match_parent"
                android:layout_marginBottom="12dp"
                app:strokeColor="?attr/colorOutline"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="@android:color/transparent"
                style="@style/Widget.Material3.CardView.Outlined"
                android:layout_marginTop="4dp"
                app:cardCornerRadius="16dp"
                android:id="@+id/custom_command_progress_card">

                <LinearLayout
                    android:layout_height="wrap_content"
                    android:layout_width="match_parent"
                    android:padding="16dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_height="wrap_content"
                        android:layout_width="match_parent"
                        android:textSize="16sp"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="?attr/colorOnSurface"
                        android:text="@string/custom_command_progress_title" />

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:layout_height="wrap_content"
                        android:layout_width="match_parent"
                        android:max="100"
                        android:indeterminate="false"
                        app:trackColor="?attr/colorSurfaceContainerHighest"
                        style="@style/Widget.Material3.LinearProgressIndicator"
                        android:layout_marginTop="12dp"
                        android:progress="0"
                        app:trackThickness="4dp"
                        android:id="@+id/custom_command_progress_bar"
                        app:indicatorColor="?attr/colorPrimary" />

                    <TextView
                        android:layout_height="wrap_content"
                        android:layout_width="match_parent"
                        android:textSize="13sp"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:id="@+id/custom_command_status"
                        android:paddingTop="10dp"
                        android:text="@string/custom_command_status_idle" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_height="wrap_content"
                android:layout_width="match_parent"
                android:layout_marginBottom="8dp"
                app:strokeColor="?attr/colorOutline"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="@android:color/transparent"
                style="@style/Widget.Material3.CardView.Outlined"
                app:cardCornerRadius="16dp"
                android:id="@+id/custom_command_log_card">

                <LinearLayout
                    android:layout_height="wrap_content"
                    android:layout_width="match_parent"
                    android:padding="16dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_height="wrap_content"
                        android:layout_width="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_height="wrap_content"
                            android:layout_width="0dp"
                            android:textSize="16sp"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="?attr/colorOnSurface"
                            android:layout_weight="1"
                            android:text="@string/custom_command_log_title" />

                        <com.google.android.material.button.MaterialButton
                            android:layout_height="wrap_content"
                            android:layout_width="wrap_content"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:minWidth="0dp"
                            android:id="@+id/custom_command_clear_log"
                            android:text="@string/custom_command_clear_log" />

                        <com.google.android.material.button.MaterialButton
                            android:layout_height="wrap_content"
                            android:layout_width="wrap_content"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:minWidth="0dp"
                            android:id="@+id/custom_command_copy_log"
                            android:text="@string/custom_command_copy_log" />

                    </LinearLayout>

                    <TextView
                        android:layout_height="wrap_content"
                        android:layout_width="match_parent"
                        android:textSize="12sp"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:layout_marginTop="2dp"
                        android:text="@string/custom_command_log_desc" />

                    <ScrollView
                        android:layout_height="180dp"
                        android:layout_width="match_parent"
                        android:scrollbars="vertical"
                        android:background="?attr/colorSurfaceContainerHigh"
                        android:scrollbarStyle="insideOverlay"
                        android:fillViewport="false"
                        android:fadeScrollbars="true"
                        android:layout_marginTop="10dp"
                        android:id="@+id/custom_command_log_scroll">

                        <TextView
                            android:layout_height="wrap_content"
                            android:layout_width="match_parent"
                            android:padding="12dp"
                            android:focusableInTouchMode="false"
                            android:fontFamily="monospace"
                            android:textSize="11sp"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:focusable="false"
                            android:textIsSelectable="false"
                            android:id="@+id/custom_command_log_text"
                            android:text="@string/custom_command_log_empty" />

                    </ScrollView>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
